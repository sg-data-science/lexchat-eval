# Personal Claude Code settings (hooks, permissions). Project-wide settings
# would go in .claude/settings.json, which is not ignored.
.claude/settings.local.json

# Point-in-time findings: dated analysis, debugging notes and review status.
# Written to be frozen, not maintained, so they are kept locally rather than
# committed. Permanent docs live directly in lex_eval/docs/ and in decisions/.
lex_eval/docs/findings/

# Word review documents returned by lawyers. They carry reviewers' names and
# are binary; the decision is transcribed into .authored/q{id}/review.json,
# which is what is committed.
lex_eval/data/reference_answers/reviews/
*.docx
*.docx.bak

# CA bundles for a TLS-inspecting proxy, kept on the server only.
deploy/ca/*
!deploy/ca/README.md
deploy/smoke/smoke.log
